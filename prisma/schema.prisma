// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ramp {
  id          String   @id @default(cuid())
  name        String
  lat         Float
  lng         Float
  province    String
  type        String   // trailer, hand, dock
  fee         String?
  parking     Boolean  @default(false)
  toilets     Boolean  @default(false)
  fourWD      Boolean  @default(false)
  photo       String?
  description String?
  address     String?
  amenities   String?  // JSON string for additional amenities
  source      String   // ontario-gov, bc-gov, osm, user-submitted
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([province])
  @@index([approved])
  @@index([lat, lng])
}

model Submission {
  id          String   @id @default(cuid())
  name        String
  lat         Float
  lng         Float
  province    String
  type        String
  fee         String?
  parking     Boolean  @default(false)
  toilets     Boolean  @default(false)
  fourWD      Boolean  @default(false)
  description String?
  address     String?
  submitterEmail String?
  submitterName  String?
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
